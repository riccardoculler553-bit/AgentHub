APP_HOST=127.0.0.1
APP_PORT=8000

# Public base URL that device clients pass as --server
SERVER_PUBLIC_URL=https://device.example.com

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=datapilot
DB_PASSWORD=change-me
DB_NAME=datapilot

REGISTRATION_CODE_TTL=300
HEARTBEAT_INTERVAL=15
OFFLINE_THRESHOLD=45

# AgentHub
# Admin token for management APIs / Dashboard; empty = open mode (local dev only)
AGENTHUB_ADMIN_TOKEN=
TASK_OFFLINE_MAX_WAIT=600
TASK_MAX_ATTEMPTS=3

# Main Agent LLM planning (empty key -> rule-based fallback planner)
OPENAI_API_KEY=
OPENAI_API_BASE=
AGENTHUB_MODEL=gpt-4o-mini
AGENT_POLL_INTERVAL=2
AGENT_MAX_WAIT=300

# --- MVP: DingTalk -> Main Agent -> yingdao.audit ---
# Background agent run wait cap (yingdao.audit timeout is 1800s)
AGENT_RUN_MAX_WAIT=1900
# Device assumed in help replies when the message names none
AGENT_DEFAULT_DEVICE_NAME=办公室电脑02
# 业务->命令->设备路由表 JSON; empty = server/config/agent_tools.json
AGENT_TOOLS_CONFIG=
# DingTalk robot (Stream Mode); empty = integration disabled.
# Requires: pip install dingtalk-stream
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_ROBOT_CODE=
# Per-group throttle seconds; <=0 disables
DINGTALK_THROTTLE_SECONDS=30

# --- V1.2 Tool-Using Agent (LangGraph) ---
# mvp = fixed-pipeline MVP agent handles DingTalk/API messages;
# tool_agent = V1.2 LangGraph agent (tools + confirmation + resume).
# tool_agent requires OPENAI_API_KEY, otherwise runs fail with AGENT_LLM_ERROR.
AGENT_MODE=mvp
# Per-run tool call budget (PDF §41)
AGENT_MAX_TOOL_CALLS=8
# Transient LLM failure retries (PDF §127)
AGENT_MAX_LLM_RETRIES=2
# Tool-call inline wait cap for task results (execute_command/retry_task)
AGENT_TOOL_WAIT_MAX=1900
# Require user confirmation before ACTION tools (execute_command)
AGENT_CONFIRM_ACTIONS=false
# Reasoning-loop wall-clock guard seconds (PDF §42)
AGENT_MAX_RUNTIME=120
